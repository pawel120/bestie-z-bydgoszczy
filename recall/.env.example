# Recall.ai: the bot that joins Google Meet (https://www.recall.ai → API keys)
RECALL_API_KEY=
# Region of your Recall workspace: us-west-2 (pay-as-you-go), us-east-1, eu-central-1, ap-northeast-1
# RECALL_REGION=us-west-2
# Public address of this page (dist/ hosted anywhere, or a cloudflared tunnel to `npm run preview`)
# BESTIE_WEB_URL=https://…
# BESTIE_LANG=pl
# BESTIE_BOT_NAME=Bestie

# Same as the desktop app (missing ones are read from ../.env); passed to the page in the URL fragment:
ELEVENLABS_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
