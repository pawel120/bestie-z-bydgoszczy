OPENROUTER_API_KEY=sk-or-...
# Mózg agentów: jev (OpenRouter Decisions, domyślnie) albo llm (stary agent czatowy)
HORDE_BRAIN=jev
# Tani model czatu do cytatów z ankiety wyjścia
HORDE_QUOTE_MODELS=openai/gpt-oss-120b,x-ai/grok-4-fast
# Modele czatu (podsumowanie, persony, mózg przy HORDE_BRAIN=llm) + zapasowe (OpenRouter sam przełączy przy błędzie)
HORDE_MODELS=typesafe/jev-router,x-ai/grok-4-fast,openai/gpt-oss-120b
# Twardy limit wydatków na jeden przebieg (USD)
HORDE_BUDGET_USD=0.15
HORDE_CONCURRENCY=8
PORT=3333
